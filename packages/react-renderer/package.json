{
  "name": "@chart-platform/react-renderer",
  "version": "0.1.0",
  "private": false,
  "description": "React renderer for Chart Platform Library based on Apache ECharts.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "keywords": [
    "charts",
    "echarts",
    "react",
    "typescript",
    "visualization",
    "multiplatform",
    "react-component"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tamilakk/chart-platform-library.git",
    "directory": "packages/react-renderer"
  },
  "homepage": "https://github.com/tamilakk/chart-platform-library#readme",
  "bugs": {
    "url": "https://github.com/tamilakk/chart-platform-library/issues"
  },
  "dependencies": {
    "@chart-platform/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "echarts": ">=6",
    "echarts-for-react": ">=3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}