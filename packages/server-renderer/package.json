{
  "name": "@chart-platform/server-renderer",
  "version": "0.1.0",
  "private": false,
  "description": "Server-side SVG and PNG renderer for Chart Platform Library.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "tsc -p tsconfig.demo.json",
    "demo": "pnpm run build:demo && node dist-demo/dev-test.js"
  },
  "keywords": [
    "charts",
    "echarts",
    "nodejs",
    "typescript",
    "visualization",
    "multiplatform",
    "svg",
    "png",
    "server-side-rendering"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tamilakk/chart-platform-library.git",
    "directory": "packages/server-renderer"
  },
  "homepage": "https://github.com/tamilakk/chart-platform-library#readme",
  "bugs": {
    "url": "https://github.com/tamilakk/chart-platform-library/issues"
  },
  "dependencies": {
    "@chart-platform/core": "workspace:*",
    "echarts": "^6.0.0",
    "sharp": "^0.34.5"
  }
}