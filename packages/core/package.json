{
  "name": "@chart-platform/core",
  "version": "0.1.0",
  "private": false,
  "description": "Shared chart definitions, validation and Apache ECharts adapter for Chart Platform Library.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "charts",
    "echarts",
    "typescript",
    "visualization",
    "multiplatform",
    "chart-definition"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tamilakk/chart-platform-library.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/tamilakk/chart-platform-library#readme",
  "bugs": {
    "url": "https://github.com/tamilakk/chart-platform-library/issues"
  }
}
