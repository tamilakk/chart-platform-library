{
  "compilerOptions": {
    "target": "ES2020",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "esModuleInterop": true,

    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "dist",
    "composite": true,

    "module": "Node16",
    "moduleResolution": "node16"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/__fixtures__/**"]
}